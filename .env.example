# Privacy Saathi: copy to .env.local (never commit real values)
NEXT_PUBLIC_SITE_URL=https://privacysaathi.in
NEXT_PUBLIC_GA_ID=            # optional GA4 id
NEXT_PUBLIC_BOOKING_URL=      # optional Cal.com / Calendly link
CMS_ADMIN_PASSWORD=           # long and unique: signs you in at /qwedsa and encrypts saved settings
SETTINGS_DIR=                 # writable folder OUTSIDE the website files for encrypted settings
SETTINGS_SECRET=              # optional separate encryption phrase
LEADS_DIR=                    # writable folder that survives restarts (leads, scans, CRM)

PS_PRIMARY_HOST=privacysaathi.in
PS_ALIAS_HOSTS=privacysathi.in,privacysaathi.com,privacysathi.com
PS_SOURCE_BY_HOST=
PS_BROWSER_PROBE=             # 1 = real-browser cookie test (needs Chromium on the server)
PS_SECRET=                    # long random string
PS_DATA_DIR=
PS_RETENTION_DAYS=90
PS_MAX_CONCURRENT=3
PS_BLOCKED_HOSTS=
PS_CRON_SECRET=               # 16+ random chars for /api/ps/daily-report and /api/ps/followups
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Email, WhatsApp and SMS can also be saved in /qwedsa/settings.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=
PS_NOTIFY_WEBHOOK=
PS_MAIL_OUTBOX=
